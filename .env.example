DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_ops
# Required. The server won't start without both. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Encrypts Shopify tokens and Slack webhook URLs in the database. If you lose
# it, stored tokens can't be read and stores must be reconnected.
ENCRYPTION_KEY=
PORT=3000

# --- Phase 4: event-triggered agent ---
SHOPIFY_WEBHOOK_SECRET=your_shopify_app_client_secret
DEEPSEEK_API_KEY=
MCP_SERVER_PATH=C:/path/to/ai-ops-mcp/server.js
