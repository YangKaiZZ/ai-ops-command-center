DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_ops
# Required. The server won't start without both. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Encrypts Shopify tokens and Slack webhook URLs in the database. If you lose
# it, stored tokens can't be read and stores must be reconnected.
ENCRYPTION_KEY=
PORT=3000

# --- Shopify app (see "Connecting a store" in the README) ---
# Client ID and secret of your app in the Shopify Dev Dashboard. The secret
# also verifies webhooks. (SHOPIFY_WEBHOOK_SECRET is still read if this is unset.)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# This backend's public https URL (an ngrok tunnel while developing). Shopify
# redirects to APP_URL/api/shopify/callback and sends webhooks here.
APP_URL=
# Optional: a code sign-up must include, so strangers can't create accounts
# (and connect stores that spend LLM credits). Empty = anyone can sign up.
SIGNUP_INVITE_CODE=
# Where the dashboard runs: sellers come back here after connecting, and
# links in emails and alerts (password reset, rating a decision) point here.
DASHBOARD_URL=http://localhost:3005
# SHOPIFY_SCOPES=read_orders,read_products,read_inventory,write_merchant_managed_fulfillment_orders

# --- Event-triggered agent ---
# The AI model behind the agent and Chat: OpenAI by default (gpt-5-nano). Its API
# data isn't used for training; abuse logs are kept up to 30 days.
AI_API_KEY=
# Optional. openai (default) or deepseek; AI_MODEL overrides the provider's
# default model; AI_REASONING_EFFORT (minimal|low|medium|high) applies to gpt-5
# models and defaults to low. AI_BASE_URL is for another OpenAI-compatible API.
# AI_PROVIDER=openai
# AI_MODEL=gpt-5-nano
# AI_REASONING_EFFORT=low
# AI_BASE_URL=
# An older DEEPSEEK_API_KEY still works when AI_API_KEY is blank (DeepSeek may
# train on the data and stores it in China).
DEEPSEEK_API_KEY=
MCP_SERVER_PATH=C:/path/to/ai-ops-command-center/mcp/server.js
# Daily caps on agent runs, per account and for all accounts together (each
# run makes at most 6 model calls). Over a cap, the event is saved as
# "Skipped". Blank = 50 and 200; 0 turns the agent off.
AGENT_DAILY_LIMIT_PER_ACCOUNT=
AGENT_DAILY_LIMIT_TOTAL=
# Dashboard chat: questions per day (each up to 6 model calls), per account
# and for all accounts together. Separate from the agent's caps. Blank = 40
# and 400; 0 turns chat off.
CHAT_DAILY_LIMIT_PER_ACCOUNT=
CHAT_DAILY_LIMIT_TOTAL=

# Shown on the privacy policy page (/privacy): who runs this server and an
# address for privacy questions. Until both are set, the page says so.
PRIVACY_OPERATOR=
PRIVACY_CONTACT_EMAIL=

# Alerts to you, the operator, when something breaks (a job failing for good,
# a store's sync failing repeatedly or its token refresh refused, a webhook
# failing, the agent's total cap, every backend start). Email needs SMTP_URL
# and EMAIL_FROM; Telegram needs TELEGRAM_BOT_TOKEN. Blank = logged only.
OPS_ALERT_EMAIL=
OPS_ALERT_TELEGRAM_CHAT_ID=

# --- Alert channels (optional; each shows in Settings only when set) ---
# Email through any SMTP provider (also sends password reset links; without it
# "Forgot your password?" says it isn't set up), e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="Arbiter Ops <alerts@example.com>"
# One Telegram bot for the whole app (create it with @BotFather). The backend
# long-polls it, so no public URL is needed; only one backend may poll a bot.
TELEGRAM_BOT_TOKEN=

# Re-sync every connected store this often, in case a webhook was missed. 0 = off.
SYNC_INTERVAL_MINUTES=15

# How often to check for daily summaries and late orders that are due (each
# seller turns them on in Settings). 0 = never send them.
REPORT_CHECK_MINUTES=5

# "Try the demo" on the sign-in page: each visitor gets a sample store of
# their own (no real Shopify store, no model calls), deleted after DEMO_HOURS.
# DEMO_ENABLED=false turns it off; DEMO_MAX_ACTIVE caps how many exist at once.
# DEMO_ENABLED=true
# DEMO_HOURS=4
# DEMO_MAX_ACTIVE=200
