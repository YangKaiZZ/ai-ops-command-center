# Copy to .env and fill in. docker compose reads .env from this folder.

# --- Where it runs ---
# Your domain (or subdomain), with a DNS A record pointing at this server.
# The dashboard, the API and Shopify's callbacks are all served from it.
DOMAIN=ops.example.com

# --- Secrets: random values, generated once (see README, step 4) ---
JWT_SECRET=
# Encrypts Shopify tokens and Slack webhook URLs in the database. Keep a copy
# somewhere safe: without it, stored tokens can't be read and every store has
# to be connected again.
ENCRYPTION_KEY=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Shopify app (Client ID and secret from the Shopify Dev Dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_orders,read_products,read_inventory

# --- The agent ---
DEEPSEEK_API_KEY=
# Daily caps on agent runs, so nobody can run up the DeepSeek bill: per
# account, and for all accounts together (each run makes at most 6 DeepSeek
# calls). Over a cap, the event is saved as "Skipped" instead of checked.
# Blank = 50 per account and 200 in total; 0 turns the agent off.
AGENT_DAILY_LIMIT_PER_ACCOUNT=
AGENT_DAILY_LIMIT_TOTAL=

# Sign-up needs this code, so strangers can't create accounts and spend LLM
# credits before you're ready. Empty = anyone can sign up.
SIGNUP_INVITE_CODE=

# --- Alert channels (optional; each shows in Settings only when set) ---
# Any SMTP provider (also sends password reset links), e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="AI Ops <alerts@example.com>"
# A bot from @BotFather. Only one backend may use a bot at a time, so give
# this server its own bot, not the one your local backend uses.
TELEGRAM_BOT_TOKEN=

# Re-sync every connected store this often, in case a webhook was missed. 0 = off.
SYNC_INTERVAL_MINUTES=15

# Ports Caddy listens on. Only change these to try the stack on your own
# computer next to other servers (see "Try it locally" in the README).
# HTTP_PORT=80
# HTTPS_PORT=443
